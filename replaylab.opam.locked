opam-version: "2.0"
name: "replaylab"
version: "dev"
synopsis: "Deterministic exchange simulation and correctness workbench"
maintainer: "Dhyey Patel"
authors: "Dhyey Patel"
license: "MIT"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "digestif" {= "1.3.0"}
  "dune" {= "3.17.2"}
  "eqaf" {= "0.10"}
  "ocaml" {= "5.2.1"}
  "ocaml-base-compiler" {= "5.2.1"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "seq" {= "base"}
  "yojson" {= "2.2.2"}
]
build: ["dune" "build" "-p" name "-j" jobs]